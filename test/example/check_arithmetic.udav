# RUN: %udav %s | FileCheck --match-full-lines --strict-whitespace %s

fun main():
    println(1) #CHECK:1
    println(6 + 7) #CHECK-NEXT:13
    println(6 + 7 + 8) #CHECK-NEXT:21

    println(-6) #CHECK-NEXT:-6
    println(6 - 7) #CHECK-NEXT:-1
    println(7 - 6) #CHECK-NEXT:1
    println(7 - 6 - 5) #CHECK-NEXT:-4

    println(6 * 7) #CHECK-NEXT:42
    println(-6 * 7) #CHECK-NEXT:-42
    println(-6 * -7) #CHECK-NEXT:42
    println(-6 * -7 * -2) #CHECK-NEXT:-84

    println(6 / 6) #CHECK-NEXT:1
    println(6 / 7) #CHECK-NEXT:0
    println(6 / -7) #CHECK-NEXT:0
    println(-6 / 5) #CHECK-NEXT:-1
    println(-6 / -5) #CHECK-NEXT:1
    println(50 / 3 / -5) #CHECK-NEXT:-3

    println(6 % 7) #CHECK-NEXT:6
    println(7 % 7) #CHECK-NEXT:0
    println(10 % 7) #CHECK-NEXT:3
    println(-6 % 7) #CHECK-NEXT:-6
    println(6 % 7 % 4) #CHECK-NEXT:2

    println(2 ** 3) #CHECK-NEXT:8
    println(-2 ** 3) #CHECK-NEXT:-8
    println(2 ** 0) #CHECK-NEXT:1
    println(2 ** 3 ** 2) #CHECK-NEXT:512

    println(5 & 5) #CHECK-NEXT:5
    println(5 & 3) #CHECK-NEXT:1
    println(5 & 3 & 2) #CHECK-NEXT:0

    println(5 | 5) #CHECK-NEXT:5
    println(5 | 3) #CHECK-NEXT:7
    println(5 | 3 | 0) #CHECK-NEXT:7

    println(5 ^ 2) #CHECK-NEXT:7
    println(5 ^ 5) #CHECK-NEXT:0
    println(5 ^ 6) #CHECK-NEXT:3

    println(5 << 1) #CHECK-NEXT:10
    println(3 << 2) #CHECK-NEXT:12

    println(5 >> 1) #CHECK-NEXT:2
    println(5 >> 2) #CHECK-NEXT:1